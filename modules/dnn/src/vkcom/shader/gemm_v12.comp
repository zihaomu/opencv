                bshare[0][b_local_x][s * B_INSTRIP + b_local_y] = weight_data[boffset + s * B_INSTRIP * p.N + i * KSTRIP_LEN * p.N];
            }
            barrier();
        }

        // compute register 1
//        for (int j = 1; j < KSTRIP_LEN; j++)
