        if (i < p.KStrip)
        {
            // load smem to register 0.
            for (int m = 0; m < 4; m++)
            {
                panleA[0][m] = ashare[0][0][local_x*4 + m];
            }

            for (int m = 0; m < 4; m++)
            {
                panleB[0][m] = bshare[0][local_y + 16 * m][0];
            }
        }
    }

