        ashare[0][a_local_x][s * A_INSTRIP + a_local_y] = image_data[aoffset + s * A_INSTRIP * p.K];
    }

    // Load B to shared B0, transpose B
    for (int s = 0; s < B_STRIP; s++)
    {
        bshare[0][b_local_x][s * B_INSTRIP + b_local_y] = weight_data[boffset + s * B_INSTRIP * p.N];
    }

    barrier();
    // load smem to register 0.
    for (int m = 0; m < 4; m++)
    {
        panleA[0][m] = ashare[0][0][local_x*4 + m];
    }

    for (int m = 0; m < 4; m++)
